cabal-version: 3.0
name:          hott
version:       0.0.0
category:      Language

common settings
  default-language:   GHC2021
  default-extensions:
    NoImplicitPrelude
    BlockArguments
    DataKinds
    DefaultSignatures
    DerivingStrategies
    FunctionalDependencies
    LambdaCase
    MultiWayIf
    OverloadedStrings
    PatternSynonyms
    QuasiQuotes
    RecordWildCards
    TypeFamilies
    ViewPatterns

  build-depends:
    , base  >=4.17
    , mtl
    , text  >=2.0

  ghc-options:        -Wall -Wno-unticked-promoted-constructors

library
  import:          settings
  hs-source-dirs:  lib
  exposed-modules:
    Language.Hott
    Language.Hott.Monad
